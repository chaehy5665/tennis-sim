<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws still frames of the 2.5D broadcast view from a replay, using the coach app layer's projection and motion
       code (no UnityEngine) with Unity 6's C# 9. Design review only: it reads a record and writes SVG/PNG files. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>9.0</LangVersion><Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><ImplicitUsings>disable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/TennisSim.UnityViewer/Assets/TennisSim/Coach/App/*.cs" Link="App/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/TennisSim.Core/TennisSim.Core.csproj" />
    <ProjectReference Include="../../src/TennisSim.Cli/TennisSim.Cli.csproj" />
  </ItemGroup>
</Project>
