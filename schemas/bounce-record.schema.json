{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tennissim.local/schemas/bounce-record.schema.json",
  "title": "TennisSim bounce impact record",
  "description": "One measured or synthetic ball-surface impact. Evidence class is mandatory and is never relabelled. Unmeasured quantities stay numeric zero and are declared false in observed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordId", "datasetId", "sourceId", "evidenceType", "sessionId", "impactTimeS", "positionM", "normal", "velocityBeforeMS", "velocityAfterMS", "angularVelocityBeforeRadS", "angularVelocityAfterRadS", "observed", "velocityAfterStdDevMS", "angularVelocityAfterStdDevRadS"],
  "properties": {
    "recordId": { "type": "string", "minLength": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "evidenceType": { "enum": ["MEASURED_RAW", "PUBLISHED_MEASUREMENT", "DIGITIZED_MEASUREMENT", "NORMATIVE_CONSTRAINT", "SYNTHETIC", "ASSUMED_PRIOR"] },
    "experimentId": { "type": "string" },
    "sessionId": { "type": "string", "minLength": 1 },
    "sampleId": { "type": "string" },
    "ballId": { "type": "string" },
    "ballBatchId": { "type": "string" },
    "ballSpecId": { "type": "string", "minLength": 1 },
    "surfaceId": { "type": "string" },
    "surfaceConditionId": { "type": "string" },
    "locationId": { "type": "string" },
    "sourceCoordinateSystem": { "type": "string" },
    "transformRevision": { "type": "integer", "minimum": 1 },
    "impactTimeS": { "type": "number" },
    "positionM": { "$ref": "#/$defs/vec3" },
    "normal": { "$ref": "#/$defs/vec3" },
    "velocityBeforeMS": { "$ref": "#/$defs/vec3" },
    "velocityAfterMS": { "$ref": "#/$defs/vec3" },
    "angularVelocityBeforeRadS": { "$ref": "#/$defs/vec3" },
    "angularVelocityAfterRadS": { "$ref": "#/$defs/vec3" },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["velocityAfter", "angularVelocityAfter", "angularVelocityBeforeMeasured"],
      "properties": {
        "velocityAfter": { "type": "array", "items": { "type": "boolean" }, "minItems": 3, "maxItems": 3 },
        "angularVelocityAfter": { "type": "array", "items": { "type": "boolean" }, "minItems": 3, "maxItems": 3 },
        "angularVelocityBeforeMeasured": { "type": "boolean" },
        "positionMeasured": { "type": "boolean" },
        "normalMeasured": { "type": "boolean" }
      }
    },
    "velocityAfterStdDevMS": { "$ref": "#/$defs/vec3Positive" },
    "angularVelocityAfterStdDevRadS": { "$ref": "#/$defs/vec3Positive" },
    "ballTemperatureC": { "type": ["number", "null"] },
    "airTemperatureC": { "type": ["number", "null"] },
    "surfaceTemperatureC": { "type": ["number", "null"] },
    "relativeHumidity": { "type": ["number", "null"] },
    "atmosphericPressurePa": { "type": ["number", "null"] },
    "ballUsageMetadata": { "type": "string" },
    "acquisitionMethod": { "type": "string" },
    "sourcePage": { "type": "string" },
    "sourceTableOrFigure": { "type": "string" },
    "sourceRow": { "type": "string" },
    "extractionMethod": { "type": "string" },
    "extractionUncertainty": { "type": ["number", "null"] },
    "qualityFlags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "vec3Positive": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 }
  }
}
