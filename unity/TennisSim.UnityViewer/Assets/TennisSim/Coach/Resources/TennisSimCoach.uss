/* TennisSim Coach UI design system (tokens v2) with its Unity UI Toolkit rules (project/unity.md):
   min-height stands in for line-height, C# uppercases label text, focus keeps the element size. */
:root {
    --ground: #060b11;
    --court: #144040;
    --line: #ffffff;
    --net: #8c969e;
    --line-muted: #aab4bb;
    --control-border: #8c969e;
    --selected: #ffffff;
    --on-selected: #060b11;
    --info-surface: #1c2630;
    --info-border: #aab4bb;
    --player-a: #ff731f;
    --player-b: #40a6ff;
    --ball: #ffeb04;
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 32px;
}
.tsc-root { flex-grow: 1; background-color: var(--ground); }
.tsc-root .unity-text-element { color: var(--line); white-space: normal; margin: 0; padding: 0; }

/* Type. Weight comes from the font file (C# assigns Pretendard-Bold or JetBrainsMono-Bold for 600/700 steps),
   so -unity-font-style stays normal to avoid a synthetic bold on top of the bold file. */
.tsc-root .tsc-headline { font-size: 28px; -unity-font-style: normal; letter-spacing: -0.28px; min-height: 34px; }
.tsc-root .tsc-title { font-size: 18px; -unity-font-style: normal; min-height: 24px; }
.tsc-root .tsc-body { font-size: 15px; min-height: 22px; }
.tsc-root .tsc-label { font-size: 12px; -unity-font-style: normal; letter-spacing: 0.72px; min-height: 16px; }
.tsc-root .tsc-score { font-size: 40px; -unity-font-style: normal; min-height: 44px; }
.tsc-root .tsc-stat { font-size: 14px; min-height: 20px; }
.tsc-root .tsc-muted { color: var(--line-muted); }
/* net text only on ground */
.tsc-root .tsc-on-ground-muted { color: var(--net); }

/* Layout */
.tsc-row { flex-direction: row; }
.tsc-grow { flex-grow: 1; flex-shrink: 1; }
.tsc-screen { flex-grow: 1; padding: 32px; }
.tsc-header { flex-direction: row; align-items: center; height: 56px; padding-left: 32px; padding-right: 32px; border-bottom-width: 1px; border-color: var(--net); }
.tsc-steps { flex-direction: row; flex-grow: 1; flex-shrink: 0; justify-content: center; }
.tsc-root .tsc-header__title { flex-shrink: 0; }
/* Match info is whole or hidden (C# hides it when it would not fit whole); it never shrinks or ellipsizes. */
.tsc-root .tsc-header__info { flex-shrink: 0; white-space: nowrap; }
.tsc-root .tsc-step { padding: 8px 16px; margin-left: 8px; border-radius: 4px; color: var(--net); }
.tsc-root .tsc-step--current { background-color: var(--selected); color: var(--on-selected); }
.tsc-panel { flex-shrink: 0; background-color: var(--court); border-width: 1px; border-color: var(--control-border); border-radius: 0; padding: 16px; }
/* Prefixed so they outrank the text reset above (.tsc-root .unity-text-element { margin: 0 }). */
.tsc-root .tsc-gap-bottom { margin-bottom: 16px; }
.tsc-root .tsc-gap-right { margin-right: 32px; }

/* Badges and bars */
.tsc-root .tsc-badge { border-radius: 999px; height: 22px; min-width: 22px; padding-left: 8px; padding-right: 8px; -unity-text-align: middle-center; color: var(--on-selected); margin-right: 8px; }
.tsc-root .tsc-badge--trailing { margin-left: 8px; margin-right: 0; }
.tsc-badge--a { background-color: var(--player-a); }
.tsc-badge--b { background-color: var(--player-b); }
.tsc-bar-track { height: 8px; border-radius: 4px; background-color: var(--ground); flex-grow: 1; margin-left: 8px; margin-right: 8px; }
.tsc-bar-fill { height: 8px; border-radius: 4px; }
.tsc-bar-fill--a { background-color: var(--player-a); }
.tsc-bar-fill--b { background-color: var(--player-b); }

/* Chip: unselected court / control-border / line-muted; selected flips brightness. */
.tsc-root .tsc-chip { background-color: var(--court); border-width: 1px; border-color: var(--control-border); border-radius: 4px; color: var(--line-muted); margin: 0 8px 8px 0; padding: 8px; min-height: 48px; -unity-text-align: middle-left; }
.tsc-root .tsc-chip--selected { background-color: var(--selected); border-color: var(--selected); color: var(--on-selected); }
.tsc-root .tsc-chip .unity-text-element { color: var(--line-muted); }
.tsc-root .tsc-chip--selected .unity-text-element { color: var(--on-selected); }

/* Buttons */
.tsc-root .tsc-button { min-height: 48px; padding: 0 32px; border-radius: 4px; margin: 0 0 0 8px; -unity-font-style: normal; font-size: 12px; letter-spacing: 0.72px; }
.tsc-root .tsc-button--primary { background-color: var(--selected); color: var(--on-selected); border-width: 0; }
.tsc-root .tsc-button--secondary { background-color: var(--ground); color: var(--line); border-width: 1px; border-color: var(--line); }

/* Button row: right aligned, space-2 between buttons (margins set from C#), never wider than its parent. C# stacks
   it when the parent width is below the buttons' natural widths plus gaps; it has no negative margins, so its width
   never depends on its own state. */
.tsc-button-row { flex-direction: row; flex-wrap: nowrap; justify-content: flex-end; flex-shrink: 0; }
.tsc-root .tsc-button-row .tsc-button { margin: 0; flex-shrink: 0; }

/* Stacked button row: one column, every button the row's full width. */
.tsc-button-row--stacked { flex-direction: column; align-items: stretch; }

/* Content never shrinks when the screen overflows; the body scrolls instead (UI Toolkit defaults flex-shrink to 1). */
.tsc-card { flex-shrink: 0; }
.tsc-root .tsc-legend { flex-shrink: 0; margin-top: 4px; }

/* Keyboard focus: ball ring. USS has no outline, so a 2px ball border takes its place and the padding shrinks by
   the border growth so the element keeps its size (chip 1px -> 2px, secondary 1px -> 2px, primary 0 -> 2px).
   A selected chip keeps its selected fill; only the border turns ball. */
.tsc-root .tsc-chip:focus { border-width: 2px; border-color: var(--ball); padding: 7px; }
.tsc-root .tsc-button--secondary:focus { border-width: 2px; border-color: var(--ball); padding: 0 31px; }
.tsc-root .tsc-button--primary:focus { border-width: 2px; border-color: var(--ball); padding: 0 30px; }

/* InfoBanner */
.tsc-banner { flex-shrink: 0; flex-direction: row; background-color: var(--info-surface); border-width: 1px; border-color: var(--info-border); border-radius: 0; padding: 16px; }
.tsc-root .tsc-banner__icon { font-size: 12px; width: 22px; height: 22px; border-radius: 11px; border-width: 1.5px; border-color: var(--info-border); color: var(--line-muted); -unity-text-align: middle-center; margin-right: 16px; flex-shrink: 0; }

/* Inset: a ground surface inside a court panel (coach memo, change summary, segment card, heatmap). */
.tsc-inset { flex-shrink: 0; background-color: var(--ground); border-radius: 0; padding: 16px; }
.tsc-inset--compact { padding: 8px; }
.tsc-root .tsc-inset__kicker { margin-bottom: 4px; }

/* Scrollbar (vertical only): 8px, no arrow buttons, ground track, control-border thumb (line-muted on hover). */
.tsc-root .unity-scroller--horizontal { display: none; }
.tsc-root .unity-scroller--vertical { width: 8px; min-width: 8px; border-width: 0; background-color: var(--ground); }
.tsc-root .unity-scroller--vertical .unity-scroller__low-button, .tsc-root .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.tsc-root .unity-scroller--vertical .unity-scroller__slider { width: 8px; margin: 0; }
.tsc-root .unity-scroller--vertical .unity-base-slider__tracker { background-color: var(--ground); border-width: 0; }
.tsc-root .unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--control-border); border-width: 0; border-radius: 4px; left: 0; right: 0; width: 8px; margin: 0; }
.tsc-root .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--line-muted); }

/* Tables */
.tsc-table-row { flex-shrink: 0; min-height: 32px; align-items: center; flex-direction: row; border-top-width: 1px; border-color: var(--net); padding-top: 6px; padding-bottom: 6px; }
.tsc-root .tsc-cell { width: 80px; -unity-text-align: middle-right; }
.tsc-root .tsc-cell--label { flex-grow: 1; -unity-text-align: middle-left; }
